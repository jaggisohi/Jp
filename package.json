{
  "name": "jp-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn dev:web\" \"yarn dev:api\"",
    "dev:web": "yarn workspace @jp/web dev",
    "dev:api": "yarn workspace @jp/api dev",
    "dev:mobile": "yarn workspace @jp/mobile start",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
